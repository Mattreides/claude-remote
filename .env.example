# ── claude-remote configuration ──────────────────────────────────────────────
# Copy to `.env` and fill in. NEVER commit your real .env.

# From @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID (from @userinfobot). Comma-separate to allow several.
AUTHORIZED_USER_IDS=

# From console.anthropic.com
ANTHROPIC_API_KEY=

# Optional overrides
WORKING_DIR=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# LOG_FILE=
